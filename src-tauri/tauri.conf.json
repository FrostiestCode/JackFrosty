{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JackFrosty",
  "version": "0.1.0",
  "identifier": "com.jackfrosty.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "JackFrosty",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Auxio-inspired local music player for desktop",
    "longDescription": "JackFrosty plays your local library with an Auxio-like UX on Windows (default), macOS and Linux.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {},
      "appimage": {}
    },
    "macOS": {
      "dmg": {}
    }
  }
}
