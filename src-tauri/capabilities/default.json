{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Default desktop permissions for JackFrosty",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:allow-read-file",
    "fs:allow-read-dir",
    "dialog:allow-open",
    "store:allow-load",
    "store:allow-save",
    "store:allow-get",
    "store:allow-set"
  ]
}
